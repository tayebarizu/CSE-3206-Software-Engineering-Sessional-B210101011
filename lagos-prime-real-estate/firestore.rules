rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProperty(data) {
      return data.title is string && data.title.size() <= 150 &&
             data.category in ['House', 'Apartment', 'Plot'] &&
             data.type in ['Sell', 'Rent', 'Lease'] &&
             (data.price is number || data.price is int) && data.price >= 0 &&
             data.location is string && data.location.size() <= 200 &&
             data.imageUrl is string && data.imageUrl.size() <= 500000 &&
             data.ownerId is string && data.ownerId == request.auth.uid;
    }

    function isValidBooking(data) {
      return data.propertyId is string && data.propertyId.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.userEmail is string && data.userEmail.size() <= 150 &&
             data.preferredDate is string && data.preferredDate.size() <= 50 &&
             data.preferredTime is string && data.preferredTime.size() <= 50 &&
             data.status in ['Pending', 'Confirmed', 'Cancelled'];
    }

    // Properties collection: Publicly readable for property browsing
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(propertyId) && isValidProperty(incoming());
      allow update: if isSignedIn() && isValidId(propertyId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId && isValidProperty(incoming());
      allow delete: if isSignedIn() && isValidId(propertyId) && existing().ownerId == request.auth.uid;
    }

    // Bookings collection: Private to requester and property owner
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && isValidId(bookingId) && (existing().userId == request.auth.uid || existing().ownerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isSignedIn() && isValidId(bookingId) && (existing().userId == request.auth.uid || existing().ownerId == request.auth.uid) && isValidBooking(incoming());
      allow delete: if isSignedIn() && isValidId(bookingId) && existing().userId == request.auth.uid;
    }

    // User profiles: Private to individual user
    match /users/{userId} {
      allow read, write: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
    }
  }
}
