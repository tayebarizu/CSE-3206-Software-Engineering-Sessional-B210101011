{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "A real estate listing for sale, rent, or lease",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "enum": ["House", "Apartment", "Plot"] },
        "type": { "type": "string", "enum": ["Sell", "Rent", "Lease"] },
        "price": { "type": "number" },
        "location": { "type": "string", "maxLength": 200 },
        "bedrooms": { "type": "number" },
        "bathrooms": { "type": "number" },
        "area": { "type": "string", "maxLength": 50 },
        "imageUrl": { "type": "string", "maxLength": 500000 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerEmail": { "type": "string", "maxLength": 150 }
      },
      "required": ["title", "category", "type", "price", "location", "imageUrl", "ownerId"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A scheduled property viewing appointment",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string", "maxLength": 128 },
        "propertyTitle": { "type": "string", "maxLength": 150 },
        "propertyLocation": { "type": "string", "maxLength": 200 },
        "propertyPrice": { "type": "number" },
        "propertyImageUrl": { "type": "string", "maxLength": 1000 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "userPhone": { "type": "string", "maxLength": 50 },
        "preferredDate": { "type": "string", "maxLength": 50 },
        "preferredTime": { "type": "string", "maxLength": 50 },
        "viewingType": { "type": "string", "enum": ["In-person", "Virtual"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Cancelled"] }
      },
      "required": ["propertyId", "userId", "userName", "userEmail", "preferredDate", "preferredTime", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 1000 }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Real estate property listings accessible to all visitors"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Property viewing bookings reserved by users"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User private profile data"
    }
  }
}
